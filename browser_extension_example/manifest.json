{
  "manifest_version": 3,
  "name": "Secure Agentic Browser Extension",
  "version": "1.0.0",
  "description": "Browser extension that communicates with the Secure Agentic Browser API",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8001/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Agentic Browser"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}