# Secure Agentic Browser Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# API KEYS (REQUIRED)
# =============================================================================

# Google Gemini API Key (Required for AI functionality)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_actual_gemini_api_key_here

# =============================================================================
# FIREWALL CONFIGURATION (OPTIONAL)
# =============================================================================

# External Firewall API Configuration
# Set USE_EXTERNAL_FIREWALL=true when your localhost firewall is ready
USE_EXTERNAL_FIREWALL=false
FIREWALL_API_URL=http://localhost:3001/api/validate
FIREWALL_API_KEY=your_external_firewall_api_key_here



# =============================================================================
# BROWSER CONFIGURATION (OPTIONAL)
# =============================================================================

# Browser Settings
BROWSER_HEADLESS=false
BROWSER_TIMEOUT=30000

# =============================================================================
# SERVER CONFIGURATION (OPTIONAL)
# =============================================================================

# Server Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
LOG_LEVEL=INFO

# =============================================================================
# AGENT CONFIGURATION (OPTIONAL)
# =============================================================================

# Agent Behavior Settings
MAX_STEPS_PER_TASK=20
AGENT_TIMEOUT=300
DEFAULT_WAIT_TIME=2

# =============================================================================
# SECURITY SETTINGS (OPTIONAL)
# =============================================================================

# Additional Security Configuration
ENABLE_FIREWALL=true
STRICT_MODE=true
ALLOW_JAVASCRIPT_URLS=false

# =============================================================================
# DEVELOPMENT SETTINGS (OPTIONAL)
# =============================================================================

# Development and Debug Settings
DEBUG_MODE=false
VERBOSE_LOGGING=false
SAVE_SCREENSHOTS=false
SCREENSHOT_DIR=./screenshots